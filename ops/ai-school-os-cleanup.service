[Unit]
Description=AI School OS expired record cleanup
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=oneshot
User=__SERVICE_USER__
Group=__SERVICE_USER__
WorkingDirectory=__APP_ROOT__/current
EnvironmentFile=__ENV_FILE__
Environment=NODE_ENV=production
Environment=PATH=/usr/bin:/bin
Environment=HOME=/var/lib/__SERVICE_NAME__
Environment=NPM_CONFIG_CACHE=/var/lib/__SERVICE_NAME__/.npm
ExecStartPre=/usr/bin/test -r __APP_ROOT__/current/package.json
ExecStart=/usr/bin/npm run db:cleanup
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=yes
UMask=0077
StateDirectory=__SERVICE_NAME__
StateDirectoryMode=0700
ReadWritePaths=/var/lib/__SERVICE_NAME__
LimitNOFILE=65536
SyslogIdentifier=__SERVICE_NAME__-cleanup
