generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TEACHER
}

enum Plan {
  FREE
  PRO
}

enum AssignmentType {
  HOMEWORK
  ASSESSMENT
  EXAM
  MATERIAL
}

enum SubmissionStatus {
  SUBMITTED
  RETURNED
  REVIEWED
}

enum ReviewStatus {
  RETURNED
  REVIEWED
}

enum AIMessageRole {
  user
  assistant
}

enum AttachmentScanStatus {
  QUARANTINED
  CLEAN
  INFECTED
  SCAN_ERROR
}

model User {
  id                 String                        @id @default(cuid())
  email              String                        @unique
  passwordHash       String
  name               String
  role               Role
  plan               Plan                          @default(FREE)
  school             String                        @default("")
  grade              String                        @default("")
  classroom          String                        @default("")
  phone              String                        @default("")
  createdAt          DateTime                      @default(now())
  sessions           Session[]
  classes            Class[]
  memberships        ClassMember[]
  progress           AssignmentProgress[]
  submissions        Submission[]
  submissionReviews  SubmissionReview[]
  conversations      AIConversation[]
  usage              AIUsage[]
  events             PersonalEvent[]
  uploadReservations AttachmentUploadReservation[]
  teacherApprovedAt  DateTime?
  aiConsentAt        DateTime?
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime

  @@index([userId])
  @@index([expiresAt])
}

model Class {
  id                 String                        @id @default(cuid())
  name               String
  subject            String
  code               String                        @unique
  teacherId          String
  teacher            User                          @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  members            ClassMember[]
  assignments        Assignment[]
  uploadReservations AttachmentUploadReservation[]
  createdAt          DateTime                      @default(now())

  @@index([teacherId])
}

model ClassMember {
  id        String    @id @default(cuid())
  userId    String
  classId   String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  class     Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  joinedAt  DateTime  @default(now())
  removedAt DateTime?

  @@unique([userId, classId])
  @@index([classId])
  @@index([classId, removedAt])
}

model Assignment {
  id            String               @id @default(cuid())
  classId       String
  class         Class                @relation(fields: [classId], references: [id], onDelete: Cascade)
  title         String
  description   String
  rubric        String
  type          AssignmentType       @default(HOMEWORK)
  dueAt         DateTime
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  archivedAt    DateTime?
  progress      AssignmentProgress[]
  submissions   Submission[]
  conversations AIConversation[]
  attachments   Attachment[]

  @@index([classId, archivedAt, dueAt])
}

model AssignmentProgress {
  id           String     @id @default(cuid())
  userId       String
  assignmentId String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  completed    Boolean    @default(false)
  favorite     Boolean    @default(false)
  updatedAt    DateTime   @updatedAt

  @@unique([userId, assignmentId])
  @@index([assignmentId])
}

model Submission {
  id           String             @id @default(cuid())
  assignmentId String
  studentId    String
  content      String
  status       SubmissionStatus   @default(SUBMITTED)
  feedback     String             @default("")
  submittedAt  DateTime           @default(now())
  reviewedAt   DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  assignment   Assignment         @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  student      User               @relation(fields: [studentId], references: [id], onDelete: Restrict)
  reviews      SubmissionReview[]

  @@unique([assignmentId, studentId])
  @@index([assignmentId, status])
  @@index([studentId, updatedAt])
}

model SubmissionReview {
  id           String       @id @default(cuid())
  submissionId String
  reviewerId   String
  status       ReviewStatus
  feedback     String       @default("")
  createdAt    DateTime     @default(now())
  submission   Submission   @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  reviewer     User         @relation(fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([submissionId, createdAt])
  @@index([reviewerId, createdAt])
}

model AIConversation {
  id           String      @id @default(cuid())
  userId       String
  assignmentId String
  user         User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  assignment   Assignment  @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  messages     AIMessage[]
  busyUntil    DateTime    @default(now())

  @@unique([userId, assignmentId])
  @@index([assignmentId])
}

model AIMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           AIMessageRole
  content        String
  createdAt      DateTime       @default(now())

  @@index([conversationId, createdAt])
}

model AIUsage {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  day    String
  // SQL CHECK constraints require nonnegative count and tokens.
  count  Int    @default(0)
  tokens Int    @default(0)

  @@unique([userId, day])
}

model PersonalEvent {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title  String
  dueAt  DateTime

  @@index([userId, dueAt])
}

model Attachment {
  id           String               @id @default(cuid())
  assignmentId String
  assignment   Assignment           @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  name         String
  mime         String
  size         Int
  scanStatus   AttachmentScanStatus @default(QUARANTINED)
  scannedAt    DateTime?
  scanEngine   String?
  // SQL CHECK enforces 1..5 MiB, including writes outside the upload action.
  data         Bytes

  @@index([assignmentId])
}

model AttachmentUploadReservation {
  id        String   @id @default(cuid())
  classId   String
  teacherId String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher   User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  size      Int
  expiresAt DateTime

  @@index([classId, expiresAt])
  @@index([teacherId, expiresAt])
  @@index([expiresAt])
}

model RateLimit {
  key       String   @id
  // SQL CHECK requires a positive counter.
  count     Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}
